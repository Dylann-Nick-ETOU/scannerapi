{
  "openapi": "3.0.1",
  "info": { "title": "Secured API", "version": "v1" },
  "servers": [{ "url": "https://api.example.com" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/orders": {
      "get": {
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    }
  }
}
